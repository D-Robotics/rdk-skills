{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drobotics-x5/verification.schema.json",
  "title": "D-Robotics X5 Verification Record",
  "type": "object",
  "required": ["schema_version", "passed", "checks", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "passed": {"type": "boolean"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "passed", "evidence", "recorded_at"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "evidence": {"type": ["string", "null"]},
          "recorded_at": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      }
    },
    "evidence": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drobotics-x5/route.schema.json",
  "title": "D-Robotics X5 Route Decision",
  "type": "object",
  "required": ["schema_version", "platform", "selected_skill", "candidates", "rejections", "handoffs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "platform": {"const": "X5"},
    "selected_skill": {"type": "string", "pattern": "^x5-[a-z0-9-]+$"},
    "candidates": {"type": "array", "items": {"type": "string", "pattern": "^x5-[a-z0-9-]+$"}},
    "rejections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "reason"],
        "properties": {
          "skill": {"type": "string"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "handoffs": {"type": "array", "items": {"type": "string", "pattern": "^x5-[a-z0-9-]+$"}}
  },
  "additionalProperties": false
}
